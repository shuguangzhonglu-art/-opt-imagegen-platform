generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum RedeemCodeStatus {
  UNUSED
  REDEEMED
  EXPIRED
  DISABLED
}

enum TaskStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum ModerationMode {
  PRE_BLOCK
  OBSERVE
  OFF
}

enum ModerationResult {
  PASSED
  BLOCKED
  ERROR
  SAMPLED
}

enum CreditTransactionType {
  SIGNUP_BONUS
  ADMIN_ADJUSTMENT
  TEMPORARY_GRANT
  CAMPAIGN_GRANT
  SIGNUP_ACTIVITY
  REDEEM_CODE
  GENERATION_DEBIT
  GENERATION_REFUND
}

enum RedeemCreditType {
  PERMANENT
  TEMPORARY
}

enum CreditGrantSource {
  ADMIN_GRANT
  CAMPAIGN
  SIGNUP_ACTIVITY
  REDEEM_CODE
}

enum RegistrationInviteCodeStatus {
  ACTIVE
  DISABLED
}

model User {
  id            String              @id @default(cuid())
  email         String              @unique
  displayName   String?
  passwordHash  String
  status        UserStatus          @default(ACTIVE)
  role          UserRole            @default(USER)
  emailVerifiedAt DateTime?
  createdAt     DateTime            @default(now())
  lastLoginAt   DateTime?
  wallet        Wallet?
  creditGrants  CreditGrant[]
  createdCreditGrants CreditGrant[] @relation("CreditGrantCreator")
  createdCampaigns CreditCampaign[] @relation("CreditCampaignCreator")
  createdInviteCodes RegistrationInviteCode[] @relation("InviteCodeCreator")
  inviteCodeUses RegistrationInviteCodeUse[]
  sessions      Session[]
  browserLocks  BrowserLock[]
  emailTokens   EmailVerificationToken[]
  transactions  CreditTransaction[]
  redeemedCodes RedeemCode[]        @relation("RedeemedBy")
  tasks         GenerationTask[]
  images        GeneratedImage[]
  auditLogs     AdminAuditLog[]     @relation("AdminActor")
  createdCodes  RedeemCode[]        @relation("CreatedBy")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model BrowserLock {
  id            String   @id @default(cuid())
  browserKeyHash String  @unique
  userId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Wallet {
  userId    String   @id
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id            String                @id @default(cuid())
  userId        String
  type          CreditTransactionType
  amount        Int
  balanceAfter  Int
  relatedTaskId String?
  relatedCodeId String?
  note          String
  createdAt     DateTime              @default(now())
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedTask   GenerationTask?       @relation(fields: [relatedTaskId], references: [id])
  relatedCode   RedeemCode?           @relation(fields: [relatedCodeId], references: [id])
  grantUsages   CreditGrantUsage[]

  @@index([userId, createdAt])
}

model CreditGrant {
  id          String             @id @default(cuid())
  userId      String
  amount      Int
  remaining   Int
  source      CreditGrantSource  @default(ADMIN_GRANT)
  campaignId  String?
  expiresAt   DateTime?
  note        String             @default("")
  createdById String?
  createdAt   DateTime           @default(now())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User?              @relation("CreditGrantCreator", fields: [createdById], references: [id], onDelete: SetNull)
  campaign    CreditCampaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  usages      CreditGrantUsage[]

  @@index([userId, expiresAt])
  @@index([userId, remaining])
  @@index([campaignId])
}

model CreditCampaign {
  id              String        @id @default(cuid())
  name            String
  description     String        @default("")
  creditAmount    Int
  expiresAt       DateTime
  createdById     String?
  createdAt       DateTime      @default(now())
  createdBy       User?         @relation("CreditCampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  grants          CreditGrant[]

  @@index([createdAt])
  @@index([expiresAt])
}

model CreditGrantUsage {
  id            String             @id @default(cuid())
  grantId       String
  transactionId String?
  taskId        String?
  amount        Int
  createdAt     DateTime           @default(now())
  grant         CreditGrant        @relation(fields: [grantId], references: [id], onDelete: Cascade)
  transaction   CreditTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  task          GenerationTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([grantId])
  @@index([transactionId])
  @@index([taskId])
}

model RedeemCode {
  id           String           @id @default(cuid())
  code         String           @unique
  batchName    String
  creditAmount Int
  creditType   RedeemCreditType @default(PERMANENT)
  grantExpiresInHours Int?
  status       RedeemCodeStatus @default(UNUSED)
  expiresAt    DateTime?
  createdById  String?
  redeemedById String?
  redeemedAt   DateTime?
  createdAt    DateTime         @default(now())
  createdBy    User?            @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  redeemedBy   User?            @relation("RedeemedBy", fields: [redeemedById], references: [id], onDelete: SetNull)
  transactions CreditTransaction[]

  @@index([status, createdAt])
}

model GenerationTask {
  id           String              @id @default(cuid())
  userId       String
  prompt       String
  sourceImagePath String?
  sourceImagePaths String?
  style        String
  size         String
  quantity     Int
  quality      String
  unitCost     Int
  totalCost    Int
  status       TaskStatus          @default(PENDING)
  errorMessage String?
  rawError     String?
  queueJobId   String?
  retryCount   Int                 @default(0)
  requestedAt  DateTime            @default(now())
  queuedAt     DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  images       GeneratedImage[]
  transactions CreditTransaction[]
  grantUsages  CreditGrantUsage[]

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
}

model GeneratedImage {
  id        String         @id @default(cuid())
  taskId    String
  userId    String
  filePath  String
  width     Int
  height    Int
  createdAt DateTime       @default(now())
  task      GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String
  payload     String
  createdAt   DateTime @default(now())
  adminUser   User     @relation("AdminActor", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt])
}

model RegistrationInviteCode {
  id          String                       @id @default(cuid())
  code        String                       @unique
  batchName   String
  maxUses     Int                          @default(1)
  usedCount   Int                          @default(0)
  status      RegistrationInviteCodeStatus @default(ACTIVE)
  expiresAt   DateTime?
  note        String                       @default("")
  createdById String?
  createdAt   DateTime                     @default(now())
  createdBy   User?                        @relation("InviteCodeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  uses        RegistrationInviteCodeUse[]

  @@index([status, createdAt])
  @@index([batchName])
}

model RegistrationInviteCodeUse {
  id        String                 @id @default(cuid())
  codeId    String
  userId    String
  usedAt    DateTime               @default(now())
  code      RegistrationInviteCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([codeId, userId])
  @@index([userId])
  @@index([usedAt])
}

model AppSetting {
  id                Int      @id
  defaultUnitCost   Int
  availableSizes    String
  taskConcurrency   Int
  fileRetentionDays Int
  signupBonus       Int
  emailVerificationEnabled Boolean @default(true)
  smtpHost          String   @default("")
  smtpPort          Int      @default(587)
  smtpUser          String   @default("")
  smtpPassword      String   @default("")
  smtpFrom          String   @default("")
  turnstileEnabled  Boolean  @default(false)
  turnstileSiteKey  String   @default("")
  turnstileSecretKey String  @default("")
  registerRateLimitEnabled Boolean @default(true)
  registerRateLimitWindowMinutes Int @default(60)
  registerRateLimitMax Int @default(5)
  registrationInviteEnabled Boolean @default(false)
  signupActivityEnabled Boolean @default(false)
  signupActivityCredits Int @default(0)
  signupActivityExpiresInHours Int @default(24)
  signupActivityInviteOnly Boolean @default(true)
  adminMfaEnabled Boolean @default(false)
  adminApiKeyHash String @default("")
  adminApiKeyTail String @default("")
  contentModerationEnabled Boolean @default(false)
  moderationMode ModerationMode @default(PRE_BLOCK)
  moderationBaseUrl String @default("https://api.openai.com")
  moderationModel String @default("omni-moderation-latest")
  moderationApiKeys String @default("")
  moderationTimeoutMs Int @default(3000)
  moderationRetryCount Int @default(2)
  moderationSampleRate Int @default(100)
  moderationKeywordStrategy String @default("KEYWORD_AND_API")
  moderationBlockedKeywords String @default("")
  moderationRetentionDays Int @default(30)
  moderationNotifyOnHit Boolean @default(false)
  moderationBlockMessage String @default("内容审计命中风险规则，请调整输入后重试")
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())
}

model ContentModerationLog {
  id              String           @id @default(cuid())
  userId          String?
  userEmail       String?
  apiKeyTail      String?
  endpoint        String
  model           String
  result          ModerationResult
  action          String
  highestCategory String?
  highestScore    Float            @default(0)
  inputSummary    String
  latencyMs       Int              @default(0)
  queueDelayMs    Int?
  violationCount  Int              @default(0)
  autoBanned      Boolean          @default(false)
  emailSent       Boolean          @default(false)
  errorMessage    String?
  createdAt       DateTime         @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([result, createdAt])
  @@index([endpoint, createdAt])
}

model DirectImageRecord {
  id             String   @id @default(cuid())
  userKeyHash    String
  prompt         String
  size           String
  filePath       String
  width          Int
  height         Int
  sourceImagePath String?
  createdAt      DateTime @default(now())

  @@index([userKeyHash, createdAt])
}
